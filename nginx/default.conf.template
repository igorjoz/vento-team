map $https $vento_hsts {
    default "";
    on "max-age=86400";
}

map $uri $vento_cache {
    default "no-cache";
    ~^/assets/ "public, max-age=31536000, immutable";
    ~^/images/optimized/ "public, max-age=31536000, immutable";
    ~*\.(jpg|jpeg|png|webp|avif|svg)$ "public, max-age=604800";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security $vento_hsts always;
    add_header ${CSP_HEADER} "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'" always;
    add_header Cache-Control $vento_cache;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml;

    location ~ /\. { return 404; }
    location ~* "\.[a-z0-9]{1,8}$" { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
